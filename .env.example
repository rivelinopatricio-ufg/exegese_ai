# ==============================================================================
# EXEGESE AI - ENVIRONMENT CONFIGURATION (example)
# ./install.sh generates a complete .env (chmod 600) with random secrets.
# When creating it by hand, copy this file to .env and fill in every REQUIRED value.
# Never commit .env.
# ==============================================================================

# Database Configuration (PostgreSQL 17 + pgvector) - REQUIRED
# The database is not published on the host; only the app reaches it on exegese-net.
# The credentials are fixed when the pgdata volume is first initialized: changing them
# here later requires ALTER USER inside the database (see README).
# Generate:
#   POSTGRES_USER:     echo "exegese_$(openssl rand -hex 4)"
#   POSTGRES_PASSWORD: openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 32
POSTGRES_DB=exegese_db
POSTGRES_USER=
POSTGRES_PASSWORD=

# AES-256 master key for API keys stored in the database - REQUIRED
# Base64 of exactly 32 random bytes. Keep it stable: losing or changing it makes the
# stored API keys unreadable (re-enter them in the admin panel).
# Generate: openssl rand -base64 32
EXEGESE_AES_SECRET=

# Application Configuration
PORT=8080
# Google account e-mail that receives ROLE_ADMIN on first login while no administrator exists yet.
# Required to bootstrap the first administrator (no default): use your own address.
INITIAL_ADMIN_EMAIL=your-admin@your-domain.example
# Optional comma-separated allowlist of Google e-mail domains allowed to sign in
# (e.g. empresa.gov.br,parceiro.org). Empty = any Google account with a verified e-mail.
ALLOWED_EMAIL_DOMAINS=

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Multi-Provider AI Credentials & Endpoints
# GEMINI_API_KEY also enables semantic search (gemini-embedding-001, 768 dimensions); without it the
# search is full-text only and PDF ingestion fails. After setting it, run "Reindex embeddings" in /admin/documents.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=
DEEPSEEK_API_KEY=
CEREBRAS_API_KEY=
# Optional extra hosts accepted as LLM base URLs (https only), comma-separated: "host" or "PROVIDER=host"
LLM_ALLOWED_HOSTS=

# Optional local Ollama (docker-compose.override.ai*.yml); reached on the internal network
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.2
